# edit all files in a directory
function editd() {
    if [[ $# -ne 1 ]]; then
        return
    fi
    vim $(find $1 -type f)
}

# openssl handy
function pfx2pem() {
    if [[ $# -ne 1 ]]; then
        return
    fi
    local in=$1
    local out=$(basename $1 .pfx).pem
    openssl pkcs12 -in ${in} -out ${out} -nodes
}

function pfx2cer() {
    if [[ $# -ne 1 ]]; then
        return
    fi
    local in=$1
    local out=$(basename $1 .pfx).cer
    openssl pkcs12 -in ${in} -clcerts -nokeys -out ${out}
}

function pfx2chain() {
    if [[ $# -ne 1 ]]; then
        return
    fi
    local in=$1
    local out=$(basename $1 .pfx).chain
    openssl pkcs12 -in ${in} -cacerts -nokeys -out ${out}
}

function pfx2key() {
    if [[ $# -ne 1 ]]; then
        return
    fi
    local in=$1
    local out=$(basename $1 .pfx).key
    openssl pkcs12 -in ${in} -nocerts -out ${out} -nodes
    chmod 600 ${out}
}

function pfx2files() {
    pfx2key $@
    pfx2cer $@
    pfx2chain $@
}

