# SSH agent setup
function ssha() {
#    set -x
    IDLIFE=${IDLIFE:-43720}
    SSH_AGENT_ARGS="${SSH_AGENT_ARGS} -t ${IDLIFE}"
    # not in $HOME in case of exported /home
    SSHA_ENVFILE="${SSHA_ENVFILE:-/tmp/ssh-agent-$(whoami)}"
    # agent_run_state: 0=agent running w/ key; 1=agent w/o key; 2=agent not running
    local agent_run_state=$(ssh-add -l >| /dev/null 2>&1; echo $?)
    # skip agent setup if agent was forwarded
    if [ $agent_run_state -eq 2 ]; then
        if [ -r "${SSHA_ENVFILE}" ]; then
            . "${SSHA_ENVFILE}" > /dev/null
        fi
        # get agent_run_state again
        agent_run_state=$(ssh-add -l >| /dev/null 2>&1; echo $?)
        # if there is no agent, or in case the file is out of date
        if [ -z "${SSH_AUTH_SOCK}" -o ! -r "${SSH_AUTH_SOCK}" -o $agent_run_state -eq 2 ]; then
            install -m 0600 /dev/null "${SSHA_ENVFILE}"
            ssh-agent ${SSH_AGENT_ARGS} >| "${SSHA_ENVFILE}"
            . "${SSHA_ENVFILE}"
#        else
#            /usr/bin/ssh-add -l > /dev/null 2>&1
#            if [ "${?}" -eq "2" ]; then
#                AGENTCODE=`ssh-agent -t $IDLIFE`
#                echo $AGENTCODE > $SSHA_ENVFILE
#                chmod 600 $SSHA_ENVFILE
#                eval `echo $AGENTCODE`
#            fi
        fi
        # get agent_run_state again
        agent_run_state=$(ssh-add -l >| /dev/null 2>&1; echo $?)
#        # add identity to agent
#        /usr/bin/ssh-add -l > /dev/null 2>&1
#        SA_EXIT=$?
#        if [ "$SA_EXIT" -eq "1" ]; then
        if [ $agent_run_state -eq 1 ]; then
            # only prompt on login, not in every screen window if I'm ignoring it
            if [ "$SHLVL" -eq "0" ]; then
                echo "no keys in running agent - running ssh-add"
                /usr/bin/ssh-add
            else
                echo "no keys in running agent - use ssh-add to use pk auth"
            fi
        fi
    else
        if [ "$SHLVL" -eq "0" ]; then
            # if agent was forwarded make a file old/stale sessions can source to fix themselves
            echo write "${SSHA_ENVFILE}"
            install -m 0600 /dev/null "${SSHA_ENVFILE}"
            cat <<EOF > "${SSHA_ENVFILE}"
SSH_AUTH_SOCK=${SSH_AUTH_SOCK}; export SSH_AUTH_SOCK;
EOF
        fi
    fi
#    set +x
}

# convenience function for shells broken by stale settings
ssha_fix() {
    ssha
    source ${SSHA_ENVFILE}
}

# start ssh agent if flag file exists
[[ -e "${HOME}/.ssha_enable" ]] && . .ssha_enable && ssha

